{
  "name": "@agntn/puzzles",
  "version": "0.31.0",
  "description": "Crypto bounties, puzzles and challenges as class-owned data for agents",
  "keywords": [
    "bitcoin",
    "bounty",
    "cryptocurrency",
    "mcp",
    "omp-extension",
    "pi-package",
    "puzzle"
  ],
  "homepage": "https://github.com/agntn/puzzles#readme",
  "bugs": "https://github.com/agntn/puzzles/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/puzzles.git"
  },
  "bin": {
    "puzzles": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./collections/*": {
      "types": "./dist/collections/*.d.mts",
      "import": "./dist/collections/*.mjs"
    },
    "./tools": {
      "types": "./dist/tool-operations.d.mts",
      "import": "./dist/tool-operations.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "docs": "pnpm --filter docs dev",
    "fixtures": "node scripts/refresh-landing-fixtures.ts",
    "lint": "obuild && vp lint && vp fmt --check",
    "lint:fix": "obuild && vp lint --fix && vp fmt",
    "typecheck": "obuild && vp check --no-fmt --no-lint && tsc -p tsconfig.extensions.json",
    "test": "vp test",
    "test:live": "PUZZLES_LIVE=1 vp test",
    "test:packed": "node test/eval-packed.ts",
    "test:watch": "vp test watch",
    "prepack": "obuild"
  },
  "dependencies": {
    "@agntn/archives": "catalog:deps",
    "@agntn/chains": "catalog:deps",
    "@agntn/ciphers": "catalog:deps",
    "@agntn/explorers": "catalog:deps",
    "@agntn/hashes": "catalog:deps",
    "@agntn/keys": "catalog:deps",
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps",
    "@scure/base": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/curves": "catalog:dev",
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@modelcontextprotocol/sdk": "catalog:deps",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "jiti": "catalog:dev",
    "obuild": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0",
  "omp": {
    "extensions": [
      "./extensions/omp/puzzles.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/puzzles.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
