{
  "name": "@agntn/puzzles",
  "version": "0.22.0",
  "description": "Crypto bounties, puzzles and challenges as class-owned data for agents",
  "keywords": [
    "bitcoin",
    "bounty",
    "cryptocurrency",
    "mcp",
    "omp-extension",
    "pi-package",
    "puzzle"
  ],
  "homepage": "https://github.com/agntn/puzzles#readme",
  "bugs": "https://github.com/agntn/puzzles/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/puzzles.git"
  },
  "bin": {
    "puzzles": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/shared",
    "packages/omp/extensions",
    "packages/pi/extensions",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./collections/*": {
      "types": "./dist/collections/*.d.mts",
      "import": "./dist/collections/*.mjs"
    },
    "./tools": {
      "types": "./dist/tool-operations.d.mts",
      "import": "./dist/tool-operations.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "docs": "pnpm --dir docs dev",
    "fixtures": "node scripts/refresh-landing-fixtures.ts",
    "lint": "vp pack && vp lint && vp fmt --check",
    "lint:fix": "vp pack && vp lint --fix && vp fmt",
    "typecheck": "vp pack && vp check --no-fmt --no-lint && tsc -p tsconfig.extensions.json",
    "test": "vp test",
    "test:live": "PUZZLES_LIVE=1 vp test",
    "test:packed": "node test/eval-packed.ts",
    "test:watch": "vp test watch",
    "prepack": "vp pack",
    "release": "vp test && vp pack && changelogen --release --push"
  },
  "dependencies": {
    "@agntn/chains": "0.3.8",
    "@agntn/explorers": "0.5.4",
    "@agntn/keys": "0.3.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.4.0",
    "citty": "0.2.2",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@noble/curves": "2.4.0",
    "@oh-my-pi/omptype": "18.2.4",
    "@oh-my-pi/pi-coding-agent": "18.2.4",
    "@scure/base": "2.4.0",
    "@types/node": "26.2.0",
    "changelogen": "0.6.2",
    "jiti": "2.7.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "typebox": ">=1.3.14 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/puzzles.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/puzzles.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
