{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-puzzles",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://puzzles.agntn.dev",
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-puzzles",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "routes": [{ "pattern": "puzzles.agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
